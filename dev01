# -*- coding: utf-8 -*-
"""Flat XLSX export wizard for Partner Ledger, Aged Receivable, Aged Payable."""
import io
import re
import base64
from odoo import models, fields, api, _
from odoo.exceptions import UserError

try:
    import openpyxl
    from openpyxl.styles import Font, PatternFill, Alignment
except ImportError:
    openpyxl = None


REPORT_XMLID = {
    'partner_ledger': 'account_reports.partner_ledger_report',
    'aged_receivable': 'account_reports.aged_receivable_report',
    'aged_payable': 'account_reports.aged_payable_report',
}


# Patterns that identify INVOICE / MOVE references (NOT partner names)
INVOICE_PATTERNS = [
    re.compile(r'^[A-Z]{2,6}\d?\s*/\d{4}/'),   # INV/2026/, BNK2 /2022/, RINV/, CPAY /, MISC/, RBILL/
    re.compile(r'^INV\d+'),                     # INV5084772
    re.compile(r'^\d{6,}'),                     # 1122932063, 60085279, 821333286, 654072
    re.compile(r'^\d+-\d+'),                    # 114-3129776-...
    re.compile(r'^S\d{6,}'),                    # S02753620
    re.compile(r'^[A-Z]{2,}\d+\s*\(SAL'),       # 25625506B (SAL...)
]


def _looks_like_invoice_ref(text):
    """Return True if `text` looks like an invoice/move reference, not a partner name."""
    for pat in INVOICE_PATTERNS:
        if pat.search(text):
            return True
    return False


class PartnerLedgerFlatExportWizard(models.TransientModel):
    _name = 'partner.ledger.flat.export.wizard'
    _description = 'Flat Partner Report Export Wizard'

    report_type = fields.Selection([
        ('partner_ledger', 'Partner Ledger'),
        ('aged_receivable', 'Aged Receivable'),
        ('aged_payable', 'Aged Payable'),
    ], string='Report', required=True, default='partner_ledger')

    date_from = fields.Date(string='Date From')
    date_to = fields.Date(string='Date To', required=True,
                          default=fields.Date.context_today)
    company_id = fields.Many2one(
        'res.company', string='Company',
        default=lambda self: self.env.company)

    file_data = fields.Binary(string='File', readonly=True)
    file_name = fields.Char(string='File Name', readonly=True)

    def action_generate(self):
        self.ensure_one()
        if not openpyxl:
            raise UserError(_('Python library openpyxl is not installed.'))

        xmlid = REPORT_XMLID.get(self.report_type)
        if not xmlid:
            raise UserError(_('Unknown report type: %s') % self.report_type)
        report = self.env.ref(xmlid)

        date_to = self.date_to
        date_from = self.date_from or fields.Date.to_date('1900-01-01')

        if self.report_type == 'partner_ledger':
            options = report.with_context(
                allowed_company_ids=self.company_id.ids
            ).get_options({
                'date': {
                    'mode': 'range',
                    'date_from': date_from.strftime('%Y-%m-%d'),
                    'date_to': date_to.strftime('%Y-%m-%d'),
                    'filter': 'custom',
                },
                'unfold_all': True,
            })
        else:
            options = report.with_context(
                allowed_company_ids=self.company_id.ids
            ).get_options({
                'date': {
                    'mode': 'single',
                    'date_to': date_to.strftime('%Y-%m-%d'),
                    'filter': 'today',
                },
                'unfold_all': True,
            })
        options['unfold_all'] = True

        try:
            native_export = report.export_to_xlsx(options)
        except Exception as e:
            raise UserError(_('Native export failed: %s') % str(e))

        file_bytes = None
        if isinstance(native_export, dict):
            file_bytes = native_export.get('file_content')
            if not file_bytes and 'file_data' in native_export:
                file_bytes = native_export['file_data']
                if isinstance(file_bytes, str):
                    file_bytes = base64.b64decode(file_bytes)

        if not file_bytes:
            raise UserError(_(
                'Could not extract XLSX bytes from native export.'
            ))

        flattened_bytes = self._flatten_xlsx(file_bytes)

        filename = '%s_flat_%s.xlsx' % (
            self.report_type, date_to.strftime('%Y%m%d'),
        )
        self.write({
            'file_data': base64.b64encode(flattened_bytes),
            'file_name': filename,
        })

        return {
            'type': 'ir.actions.act_url',
            'url': '/web/content/?model=%s&id=%d&field=file_data&filename_field=file_name&download=true' % (
                self._name, self.id,
            ),
            'target': 'self',
        }

    def _flatten_xlsx(self, xlsx_bytes):
        wb = openpyxl.load_workbook(io.BytesIO(xlsx_bytes))

        REPORT_TITLES = {
            'aged receivable', 'aged payable', 'partner ledger',
        }
        SUBHEADERS = {
            'initial balance', 'total', 'unaffected earnings',
        }

        for ws in wb.worksheets:
            min_row = ws.min_row
            max_row = ws.max_row

            ws.insert_cols(1)

            header_row = None
            for r in range(min_row, min(min_row + 8, max_row + 1)):
                cell_c = ws.cell(row=r, column=3).value
                if cell_c and isinstance(cell_c, str) and cell_c.strip() in (
                    'Journal', 'Account', 'Invoice Date', 'At Date',
                    'Reference',
                ):
                    header_row = r
                    break

            if header_row:
                hc = ws.cell(row=header_row, column=1, value='Partner Name')
                hc.font = Font(bold=True)
                hc.fill = PatternFill(
                    start_color='D9E1F2', end_color='D9E1F2', fill_type='solid')
                hc.alignment = Alignment(horizontal='center')
                ic = ws.cell(row=header_row, column=2, value='Invoice')
                ic.font = Font(bold=True)
                ic.fill = PatternFill(
                    start_color='D9E1F2', end_color='D9E1F2', fill_type='solid')
                ic.alignment = Alignment(horizontal='center')

            current_partner = None
            rows_to_delete = []
            data_start = (header_row or min_row) + 1

            for r in range(data_start, max_row + 1):
                label = ws.cell(row=r, column=2).value
                second = ws.cell(row=r, column=3).value

                if label is None:
                    continue
                if not isinstance(label, str):
                    if current_partner:
                        ws.cell(row=r, column=1, value=current_partner)
                    continue

                stripped = label.strip()
                if not stripped:
                    continue
                lower = stripped.lower()

                if lower in REPORT_TITLES:
                    rows_to_delete.append(r)
                    continue

                if lower in SUBHEADERS:
                    if current_partner:
                        ws.cell(row=r, column=1, value=current_partner)
                    continue

                is_invoice_ref = _looks_like_invoice_ref(stripped)
                is_empty_second = (
                    second is None
                    or (isinstance(second, str) and not second.strip())
                )

                if is_invoice_ref:
                    if current_partner:
                        ws.cell(row=r, column=1, value=current_partner)
                elif is_empty_second:
                    current_partner = stripped
                    rows_to_delete.append(r)
                else:
                    if current_partner:
                        ws.cell(row=r, column=1, value=current_partner)

            for r in sorted(rows_to_delete, reverse=True):
                ws.delete_rows(r, 1)

            ws.column_dimensions['A'].width = 35

        out = io.BytesIO()
        wb.save(out)
        out.seek(0)
        return out.read()
