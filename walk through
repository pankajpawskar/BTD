```python
# -*- coding: utf-8 -*-
from odoo import models, _


class AccountReportExpanded(models.Model):
    """Extends account.report to add a fully-expanded PDF export option.

    Works for any Odoo 18 accounting report (Partner Ledger, Aged Receivable,
    Aged Payable, etc.) — they all share the account.report engine.

    The new action unfolds every unfoldable line in the report, then renders
    the standard PDF. The existing PDF/XLSX export remain untouched.
    """
    _inherit = 'account.report'

    def action_print_expanded_pdf(self, options):
        """Generate PDF with all unfoldable lines forced to unfolded state.

        :param options: report options dict from the frontend
        :return: same as standard PDF export action
        """
        # Make a safe copy so we don't mutate frontend state
        expanded_options = dict(options or {})

        # Get all lines that CAN be unfolded
        lines = self._get_lines(expanded_options)
        unfoldable_line_ids = [
            line['id'] for line in lines
            if line.get('unfoldable')
        ]

        # Force them all into the "unfolded" set
        # account.report uses options['unfolded_lines'] to track this
        existing_unfolded = list(expanded_options.get('unfolded_lines') or [])
        expanded_options['unfolded_lines'] = list(set(existing_unfolded + unfoldable_line_ids))

        # Also set the "unfold_all" flag for handlers that check it
        expanded_options['unfold_all'] = True

        # Now call the standard PDF export with our modified options
        return self.export_to_pdf(expanded_options)

    def action_print_expanded_xlsx(self, options):
        """Same as above but for XLSX export."""
        expanded_options = dict(options or {})

        lines = self._get_lines(expanded_options)
        unfoldable_line_ids = [
            line['id'] for line in lines
            if line.get('unfoldable')
        ]

        existing_unfolded = list(expanded_options.get('unfolded_lines') or [])
        expanded_options['unfolded_lines'] = list(set(existing_unfolded + unfoldable_line_ids))
        expanded_options['unfold_all'] = True

        return self.export_to_xlsx(expanded_options)
```

