# -*- coding: utf-8 -*-
"""Flat XLSX export wizard for Partner Ledger, Aged Receivable, Aged Payable.

Generates a pivot-friendly Excel with one row per move line.
Partner name is repeated on every row (no parent/child hierarchy).
"""
import io
import base64
from odoo import models, fields, api, _
from odoo.exceptions import UserError

try:
    import xlsxwriter
except ImportError:
    xlsxwriter = None


class PartnerLedgerFlatExportWizard(models.TransientModel):
    _name = 'partner.ledger.flat.export.wizard'
    _description = 'Partner Ledger Flat Export Wizard'

    report_type = fields.Selection([
        ('partner_ledger', 'Partner Ledger'),
        ('aged_receivable', 'Aged Receivable'),
        ('aged_payable', 'Aged Payable'),
    ], string='Report', required=True, default='partner_ledger')

    date_from = fields.Date(string='Date From')
    date_to = fields.Date(string='Date To', required=True,
                          default=fields.Date.context_today)
    partner_ids = fields.Many2many('res.partner', string='Partners (optional)',
                                   help='Leave empty to include all partners')
    company_id = fields.Many2one('res.company', string='Company',
                                 default=lambda self: self.env.company)

    file_data = fields.Binary(string='File', readonly=True)
    file_name = fields.Char(string='File Name', readonly=True)

    def action_generate(self):
        """Generate the flat XLSX file."""
        self.ensure_one()
        if not xlsxwriter:
            raise UserError(_('Python library xlsxwriter is not installed.'))

        # Build domain on account.move.line
        domain = [
            ('parent_state', '=', 'posted'),
            ('company_id', '=', self.company_id.id),
            ('date', '<=', self.date_to),
        ]
        if self.date_from:
            domain.append(('date', '>=', self.date_from))
        if self.partner_ids:
            domain.append(('partner_id', 'in', self.partner_ids.ids))

        # Account type filter based on report
        if self.report_type == 'aged_receivable':
            domain.append(('account_id.account_type', '=', 'asset_receivable'))
        elif self.report_type == 'aged_payable':
            domain.append(('account_id.account_type', '=', 'liability_payable'))
        else:
            # Partner Ledger: receivable + payable
            domain.append(('account_id.account_type', 'in',
                           ['asset_receivable', 'liability_payable']))

        # Also require partner set (otherwise rows are noise)
        domain.append(('partner_id', '!=', False))

        lines = self.env['account.move.line'].search(
            domain, order='partner_id, date, id'
        )

        if not lines:
            raise UserError(_('No data found for the selected criteria.'))

        # Build Excel in memory
        output = io.BytesIO()
        workbook = xlsxwriter.Workbook(output, {'in_memory': True})
        sheet_name = dict(self._fields['report_type'].selection)[self.report_type]
        sheet = workbook.add_worksheet(sheet_name[:31])

        # Formats
        header_fmt = workbook.add_format({
            'bold': True, 'bg_color': '#D9E1F2', 'border': 1,
            'align': 'center', 'valign': 'vcenter',
        })
        money_fmt = workbook.add_format({'num_format': '#,##0.00'})
        date_fmt = workbook.add_format({'num_format': 'yyyy-mm-dd'})
        text_fmt = workbook.add_format({'valign': 'top'})

        # Headers
        headers = [
            'Partner', 'Partner Ref', 'Date', 'Journal', 'Account',
            'Move Name', 'Label', 'Debit', 'Credit', 'Balance',
            'Currency', 'Matching', 'Due Date',
        ]
        for col, header in enumerate(headers):
            sheet.write(0, col, header, header_fmt)

        # Column widths
        widths = [30, 15, 12, 12, 30, 20, 35, 14, 14, 14, 10, 15, 12]
        for col, width in enumerate(widths):
            sheet.set_column(col, col, width)

        # Data rows
        running_balance_by_partner = {}
        for row_idx, line in enumerate(lines, start=1):
            partner = line.partner_id
            balance = running_balance_by_partner.get(partner.id, 0.0)
            balance += (line.debit - line.credit)
            running_balance_by_partner[partner.id] = balance

            sheet.write(row_idx, 0, partner.name or '', text_fmt)
            sheet.write(row_idx, 1, partner.ref or '', text_fmt)
            sheet.write(row_idx, 2, line.date.strftime('%Y-%m-%d') if line.date else '', date_fmt)
            sheet.write(row_idx, 3, line.journal_id.code or '', text_fmt)
            sheet.write(row_idx, 4, line.account_id.display_name or '', text_fmt)
            sheet.write(row_idx, 5, line.move_id.name or '', text_fmt)
            sheet.write(row_idx, 6, line.name or '', text_fmt)
            sheet.write_number(row_idx, 7, line.debit or 0.0, money_fmt)
            sheet.write_number(row_idx, 8, line.credit or 0.0, money_fmt)
            sheet.write_number(row_idx, 9, balance, money_fmt)
            sheet.write(row_idx, 10, line.currency_id.name or '', text_fmt)
            sheet.write(row_idx, 11, line.matching_number or '', text_fmt)
            sheet.write(row_idx, 12,
                        line.date_maturity.strftime('%Y-%m-%d') if line.date_maturity else '',
                        date_fmt)

        # Freeze header row
        sheet.freeze_panes(1, 0)

        workbook.close()
        output.seek(0)

        filename = '%s_%s.xlsx' % (
            self.report_type,
            self.date_to.strftime('%Y%m%d'),
        )
        self.write({
            'file_data': base64.b64encode(output.read()),
            'file_name': filename,
        })
        output.close()

        # Return download action
        return {
            'type': 'ir.actions.act_url',
            'url': '/web/content/?model=%s&id=%d&field=file_data&filename_field=file_name&download=true' % (
                self._name, self.id),
            'target': 'self',
        }
PYEOF
