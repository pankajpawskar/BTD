import re
manifest_path = '__manifest__.py'
with open(manifest_path, 'r') as f:
    content = f.read()

# Remove the commented broken line entirely
content = re.sub(r"\s*#\s*['\"]?q?['\"]?'?views/account_report_expanded_views\.xml',?\s*\n", "\n", content)

# Insert new files into data list before the closing ]
new_entries = "        'security/ir.model.access.csv',\n        'views/partner_ledger_flat_export_views.xml',\n"

# Find the data list closing ] and insert before it
pattern = re.compile(r"('data'\s*:\s*\[[^\]]*?)(\n\s*\],)", re.DOTALL)
def add_entries(m):
