cd ~/Projects/Enconnex/custom/enconnex_account_report && \
python3 << 'PYMOD'
import re
path = 'models/partner_ledger_flat_export.py'
with open(path) as f:
    content = f.read()

pattern = re.compile(r'    def _flatten_sheet\(self, ws\):.*?(?=\n    def |\Z)', re.DOTALL)

new_method = '''    def _flatten_sheet(self, ws):
        """Insert Partner column at A, fill with partner name on every row.
        Then delete rows where col A == col B (partner-header duplicates).
        """
        from openpyxl.styles import Font, PatternFill, Alignment
        min_row = ws.min_row
        max_row = ws.max_row

        ws.insert_cols(1)

        header_row = None
        for r in range(min_row, min(min_row + 8, max_row + 1)):
            cell_b = ws.cell(row=r, column=2).value
            if cell_b and isinstance(cell_b, str) and cell_b.strip() in (
                'Invoice Date', 'Journal', 'At Date', 'Account', 'Reference',
            ):
                header_row = r
                break

        if header_row:
            hc = ws.cell(row=header_row, column=1, value='Partner')
            hc.font = Font(bold=True)
            hc.fill = PatternFill(start_color='D9E1F2', end_color='D9E1F2',
                                  fill_type='solid')
            hc.alignment = Alignment(horizontal='center')

        current_partner = None
        data_start = (header_row or min_row) + 1

        for r in range(data_start, max_row + 1):
            label_b = ws.cell(row=r, column=2).value
            if label_b is None:
                continue
            if isinstance(label_b, str):
                stripped = label_b.strip()
                if not stripped:
                    continue
                leading = len(label_b) - len(label_b.lstrip())
                if leading == 0:
                    current_partner = stripped
                if current_partner:
                    ws.cell(row=r, column=1, value=current_partner)
            else:
                if current_partner:
                    ws.cell(row=r, column=1, value=current_partner)

        rows_to_delete = []
        for r in range(data_start, max_row + 1):
            val_a = ws.cell(row=r, column=1).value
            val_b = ws.cell(row=r, column=2).value
            if not val_a or not val_b:
                continue
            if str(val_a).strip() == str(val_b).strip():
                rows_to_delete.append(r)

        for r in sorted(rows_to_delete, reverse=True):
            ws.delete_rows(r, 1)

        ws.column_dimensions['A'].width = 35
'''

content = pattern.sub(new_method, content)
with open(path, 'w') as f:
    f.write(content)
print("OK: updated")
PYMOD
echo "Done. Now in PyCharm: stop Odoo (red square), then start (green play) with -u enconnex_account_report in Run Config parameters"
