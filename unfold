import re
path = 'models/partner_ledger_flat_export.py'
with open(path) as f:
    content = f.read()

pattern = re.compile(
    r'    def _flatten_xlsx\(self, xlsx_bytes\):.*',
    re.DOTALL
)

new_block = '''    def _flatten_xlsx(self, xlsx_bytes):
        """Post-process Odoo's native XLSX.

        Detection rules:
        - col B is NULL + label is a known REPORT TITLE -> delete row
        - col B is NULL + label is a SUBHEADER like "Initial Balance"
          -> KEEP row, tag with current partner (data is in number cols)
        - col B is NULL + any OTHER text in col A -> this IS the partner
          header. Capture partner name, delete row.
        - col B has value -> data row. Tag with current partner.
        """
        from openpyxl.styles import Font, PatternFill, Alignment
        wb = openpyxl.load_workbook(io.BytesIO(xlsx_bytes))

        REPORT_TITLES = {
            'aged receivable', 'aged payable', 'partner ledger',
        }
        # Subheader rows that should be KEPT but not treated as partner name
        SUBHEADERS = {
            'initial balance', 'total', 'unaffected earnings',
        }

        for ws in wb.worksheets:
            min_row = ws.min_row
            max_row = ws.max_row

            ws.insert_cols(1)

            header_row = None
            for r in range(min_row, min(min_row + 8, max_row + 1)):
                cell_b = ws.cell(row=r, column=2).value
                if cell_b and isinstance(cell_b, str) and cell_b.strip() in (
                    'Journal', 'Account', 'Invoice Date', 'At Date',
                    'Reference',
                ):
                    header_row = r
                    break

            if header_row:
                hc = ws.cell(row=header_row, column=1, value='Partner Name')
                hc.font = Font(bold=True)
                hc.fill = PatternFill(start_color='D9E1F2',
                                      end_color='D9E1F2',
                                      fill_type='solid')
                hc.alignment = Alignment(horizontal='center')

            current_partner = None
            rows_to_delete = []
            data_start = (header_row or min_row) + 1

            for r in range(data_start, max_row + 1):
                # After insert_cols(1):
                # col 1 = newly inserted Partner col (empty)
                # col 2 = was original col A (label like partner / Initial Balance / move name)
                # col 3 = was original col B (Journal code / Invoice Date / NULL)
                label = ws.cell(row=r, column=2).value
                second = ws.cell(row=r, column=3).value

                if label is None:
                    continue
                if not isinstance(label, str):
                    if current_partner:
                        ws.cell(row=r, column=1, value=current_partner)
                    continue

                stripped = label.strip()
                if not stripped:
                    continue

                lower = stripped.lower()

                # Report title -> delete
                if lower in REPORT_TITLES:
                    rows_to_delete.append(r)
                    continue

                # Subheader (Initial Balance / Total) -> KEEP, tag with partner
                if lower in SUBHEADERS:
                    if current_partner:
                        ws.cell(row=r, column=1, value=current_partner)
                    continue

                # second col empty -> this is a partner-header row
                is_empty_second = (
                    second is None
                    or (isinstance(second, str) and not second.strip())
                )
                if is_empty_second:
                    # Partner header
                    current_partner = stripped
                    rows_to_delete.append(r)
                else:
                    # Data row
                    if current_partner:
                        ws.cell(row=r, column=1, value=current_partner)

            for r in sorted(rows_to_delete, reverse=True):
                ws.delete_rows(r, 1)

            ws.column_dimensions['A'].width = 35

        out = io.BytesIO()
        wb.save(out)
        out.seek(0)
        return out.read()
'''

content = pattern.sub(new_block, content)
with open(path, 'w') as f:
    f.write(content)
print("OK: Initial Balance now handled as subheader, partner name preserved")
PYMOD
echo "Done. Restart Odoo with -u enconnex_account_report"
